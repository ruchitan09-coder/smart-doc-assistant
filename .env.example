# --- Database (Supabase Postgres connection string) ---
# Get this from Supabase dashboard: Project Settings > Database > Connection string (URI, use "Transaction" pooler for DATABASE_URL, "Session" pooler for DIRECT_URL)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@[HOST]:5432/postgres"

# --- Supabase (Auth + Storage) ---
# Get these from Supabase dashboard: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="documents"

# --- Groq (free LLM API, no credit card) ---
# Get a free key at console.groq.com
GROQ_API_KEY="your-groq-key"

# --- App ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Custom-trained model (optional) ---
# Leave unset to use the built-in in-app TF-IDF + logistic regression
# classifier (src/lib/classifier). Set this to the URL of the FastAPI
# inference service in ml/service (see ml/README.md) to use the real
# trained DistilBERT/TF-IDF model instead, e.g.:
# MODEL_API_URL="https://your-model-service.example.com"
MODEL_API_URL=

# --- Background job worker (optional but recommended in production) ---
# Secret required in the Authorization: Bearer header when calling
# POST /api/jobs/run from anything other than Vercel Cron itself (Vercel's
# own cron requests are identified via the x-vercel-cron header and don't
# need this). Only needed if you're using an external scheduler like
# cron-job.org instead of (or in addition to) vercel.json's cron entry.
# Generate one with: openssl rand -hex 32
CRON_SECRET=
